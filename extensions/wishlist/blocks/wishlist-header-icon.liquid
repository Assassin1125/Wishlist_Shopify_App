<button
  type="button"
  class="wishlist-header-icon"
  data-wishlist-drawer-open
  aria-label="{{ 'wishlist.trigger.label' | t }}"
  style="
    --wishlist-header-icon-size: {{ block.settings.icon_size }}px;
    --wishlist-header-icon-stroke: {{ block.settings.stroke_width }};
    --wishlist-header-icon-padding: {{ block.settings.padding }}px;
    --wishlist-header-icon-offset: {{ block.settings.vertical_offset }}px;
    {%- if block.settings.icon_color != blank %}
    color: {{ block.settings.icon_color }};
    {%- endif %}
  "
  {{ block.shopify_attributes }}
>
  {% render 'wishlist-heart-icon' %}
  <span class="wishlist-header-icon__count" data-wishlist-count hidden>0</span>
</button>

{% schema %}
{
  "name": "Wishlist header icon",
  "target": "section",
  "settings": [
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size (px)",
      "min": 14,
      "max": 40,
      "step": 1,
      "default": 24,
      "info": "Match the size of your theme's other header icons (search, cart, account)."
    },
    {
      "type": "range",
      "id": "stroke_width",
      "label": "Line weight",
      "min": 1,
      "max": 3,
      "step": 0.5,
      "default": 1.5
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Extra spacing around icon (px)",
      "min": 0,
      "max": 16,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "vertical_offset",
      "label": "Vertical nudge (px)",
      "min": -8,
      "max": 8,
      "step": 1,
      "default": 0,
      "info": "Use this if the icon sits slightly higher or lower than your other header icons."
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "info": "Leave blank to automatically match your header's text color."
    }
  ]
}
{% endschema %}
